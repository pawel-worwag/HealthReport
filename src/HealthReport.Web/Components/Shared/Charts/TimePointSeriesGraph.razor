<svg width="@Width" height="@Height" viewBox="0 0 @Width @Height" class="@Class"
     xmlns="http://www.w3.org/2000/svg" style="max-width:100%;height:auto">
     <rect width="100%" height="100%" fill="#ffffff" />
     @if (!string.IsNullOrWhiteSpace(Title))
     {
          <g>
               <text x="@(Width/2)" y="20" text-anchor="middle" font-size="16" fill="#000">@Title</text>
          </g>
     }
     @if (!string.IsNullOrWhiteSpace(XAxeTitle))
     {
          <g>
               <text x="@(Width/2)" y="@ReverseVPosition(15)" text-anchor="middle" font-size="16" fill="#000">@XAxeTitle</text>
          </g>
     }
     @if (!string.IsNullOrWhiteSpace(YAxeTitle))
     {
          <g transform="@($"rotate(-90 20 {ReverseVPosition(Height/2)})")">
               <text x="20" y="@ReverseVPosition(Height/2)" text-anchor="middle" font-size="16" fill="#000">@YAxeTitle</text>
          </g>
     }
     <line x1="100" y1="@ReverseVPosition(60)" x2="@(Width-30)" y2="@ReverseVPosition(60)" stroke="#000" stroke-width="2" />
     
     <line x1="100" y1="@ReverseVPosition(60)" x2="100" y2="50" stroke="#000" stroke-width="2" />
     <g>
          <text x="95" y="@ReverseVPosition(54)"  text-anchor="end" font-size="16" fill="#000">@YMin</text>
     </g>
     
     <g>
          <text x="95" y="56"  text-anchor="end" font-size="16" fill="#000">@YMax</text>
     </g>
</svg>