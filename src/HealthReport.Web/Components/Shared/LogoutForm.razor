<form method="post" action="/identity/logout-submit">
    <input type="hidden" name="__RequestVerificationToken" value="@_csrfToken" />
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <button type="submit" class="btn btn-link">Logout</button>
    }
</form>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}