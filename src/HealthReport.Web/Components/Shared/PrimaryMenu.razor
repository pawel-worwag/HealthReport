<div class="flex-grow-1 d-flex flex-column align-items-space-between gap-3">
    <AuthorizeView Context="auth">
        <Authorized>
            <div class="btn menuButton text-start" role="button"
                 data-bs-dismiss="offcanvas" 
                 aria-label="Close"
                 @onclick="@(async () => { await NavigateToElement("/measurements/blood-pressure"); })">
                <span class="bi bi-speedometer2 me-2"></span> Blood pressure data
            </div>
            <div class="btn menuButton text-start" role="button"
                 data-bs-dismiss="offcanvas" 
                 aria-label="Close"
                 @onclick="@(async () => { await NavigateToElement("/measurements/glucose"); })">
                <span class="bi bi-speedometer2 me-2"></span> Glucose data
            </div>
            <div class="btn menuButton text-start" role="button"
                 data-bs-dismiss="offcanvas" 
                 aria-label="Close"
                 @onclick="@(async () => { await NavigateToElement("/measurements/weight"); })">
                <span class="bi bi-speedometer2 me-2"></span> Weight data
            </div>
            <div class="btn menuButton text-start" role="button"
                 data-bs-dismiss="offcanvas" 
                 aria-label="Close"
                 @onclick="@(async () => { await NavigateToElement("/reports/simple"); })">
                <span class="bi bi-speedometer2 me-2"></span> Simple report
            </div>
            <div class="btn menuButton text-start" role="button"
                 data-bs-dismiss="offcanvas" 
                 aria-label="Close"
                 @onclick="@(async () => { await NavigateToElement("/reports/simple-avg"); })">
                <span class="bi bi-speedometer2 me-2"></span> Simple AVG report
            </div>
            <div class="btn menuButton text-start" role="button"
                 data-bs-dismiss="offcanvas" 
                 aria-label="Close"
                 @onclick="@(async () => { await NavigateToElement("/import-measurements"); })">
                <span class="bi bi-cloud-upload me-2"></span> Import measurements from CSV
            </div>
            <div class="btn logoutButton text-start" role="button"
                 data-bs-dismiss="offcanvas" 
                 aria-label="Close"
                 @onclick="@(async () => { await NavigateToElement("/identity/logout"); })">
                <span class="bi bi-box-arrow-right me-2"></span> Log out
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="btn text-start loginButton text-start" role="button"
                     data-bs-dismiss="offcanvas" 
                     aria-label="Close"
                     @onclick="@(async () => { await NavigateToElement("/identity/login"); })">
                 <span class="bi bi-box-arrow-in-right"></span> LogIn
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>
