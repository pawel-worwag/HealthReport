@page "/measurements/weight"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<h3 class="display-5 mb-3">Weight</h3>

<div class="row mb-3">
	<div class="col-md-3">
		<label class="form-label">From</label>
		<InputDate @bind-Value="From" class="form-control" />
	</div>
	<div class="col-md-3">
		<label class="form-label">To</label>
		<InputDate @bind-Value="To" class="form-control" />
	</div>
	<div class="col-md-2 d-flex align-items-end">
		<button class="btn btn-primary" @onclick="Apply">Go</button>
	</div>
</div>

@if (_data is not null)
{
	<table class="table table-hover table-sm">
		<thead>
		<tr>
			<th>MeasuredDate</th>
			<th>MeasuredTime</th>
			<th>WeightKg</th>
			<th>WeightChangeKg</th>
			<th>BMI</th>
			<th>BodyFatPercentage</th>
			<th>BodyWaterPercentage</th>
			<th>SkeletalMuscleMassKg</th>
			<th>Source</th>
			<th>CreatedAt</th>
		</tr>
		</thead>
		<tbody>
		@foreach (var r in _data)
		{
			<tr>
			<td>@r.MeasuredDate</td>
			<td>@r.MeasuredTime</td>
			<td>@r.WeightKg</td>
			<td>@r.WeightChangeKg</td>
			<td>@r.BMI</td>
			<td>@r.BodyFatPercentage</td>
			<td>@r.BodyWaterPercentage</td>
			<td>@r.SkeletalMuscleMassKg</td>
			<td>@r.Source</td>
			<td>@r.CreatedAt</td>
			</tr>
		}
		</tbody>
	</table>
}