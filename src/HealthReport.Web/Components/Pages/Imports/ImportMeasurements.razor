@page "/import-measurements"

<div class="importForm">

    <h3 class="display-5 mb-3">Import measurements from file</h3>

    @if (!_isUploading)
    {
        @if (_result is null)
        {
            <div class="mb-3">
                <label class="form-label">Import type</label>
                <InputSelect @bind-Value="_selectedSource" class="form-control"
                             disabled="@(_isUploading ? "disabled" : null)">
                    @foreach (var it in _allowedImports)
                    {
                        <option value="@it.Key">@it.Value</option>
                    }
                </InputSelect>
            </div>

            <div class="mb-3">
                <label class="form-label">File</label>
                <InputFile class="form-control" OnChange="OnInputFileChange"
                           disabled="@(_isUploading ? "disabled" : null)"/>
            </div>

            <div class="mb-3 pt-3 text-end">
                <button class="btn btn-primary" @onclick="async () => { await HandleValidSubmit(); }"
                        disabled="@(_isUploading ? "disabled" : null)">Import
                </button>
            </div>
            
        }
        else
        {
            <div class="mb-3 pt-3">
                Imported: @_result.Imported
            </div>
            @if (_result.Errors.Any())
            {
                <div class="mb-3 pt-3">
                    <p>Errors:</p>
                    <table>
                        @foreach (var l in _result.Errors)
                        {
                            <tr><td>Line @l.Line: </td><td>@l.Message</td></tr>
                        }
                    </table>
                </div>
            }
        }
    }
    else
    {
        <div class="mb-3 pt-3">
            <div class="progress" role="progressbar" aria-label="Animated striped example" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%"></div>
            </div>
            <div class="mt-1 ps-1">File: @_selectedFileName</div>
            <div class="mt-1 ps-1">Size: @(Math.Round((decimal)(_selectedFileSize) / 1024, 0)) KB</div>
        </div>
    }
</div>