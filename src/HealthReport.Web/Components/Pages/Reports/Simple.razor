@page "/reports/simple"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
<h3>Simple report</h3>

<div class="row mb-3">
	
	<div class="col-1 d-flex align-items-end text-end">
		<div class="btn-group " role="group">
			<button type="button" class="btn btn-secondary" @onclick="Prev">
				<span class="bi bi-caret-left-fill"></span>
			</button>
			<button type="button" class="btn btn-secondary" @onclick="Next">
				<span class="bi bi-caret-right-fill"></span>
			</button>
		</div>
	</div>

	<div class="col-3">
		<label class="form-label">Year</label>
		<input class="form-control" type="number" @bind="Year" min="@MinYear" max="@MaxYear"/>
	</div>
	
	<div class="col-3">
		<label class="form-label">Month</label>
		<select class="form-select" @bind="Month">
			@for (int m = 1; m <= 12; m++)
			{
				<option
					value="@m"> @m - @System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(m)</option>
			}
		</select>
	</div>
	<div class="col-3 d-flex align-items-end">

		<button class="btn btn-primary" @onclick="Submit">Go</button>
		<div class="dropdown ms-3">
			<button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
				Download
			</button>
			<ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
				<li>
					<a class="dropdown-item" href="@($"/api/reports/simple/xlsx?year={Year}&month={Month}")" target="_blank">
						<span class="bi bi-filetype-xlsx"></span>
						as Spreadsheet
					</a>
				</li>

			</ul>
		</div>
	</div>
</div>

@if (Report is not null && Report.Details.Count>0)
{
	<h3 class="pt-3">Summary</h3>
	<table class="table table-hover table-sm" style="width:auto;">
		<thead class="table-bordered">
		<tr>
			<th></th>
			<th class="text-end ps-4">Min</th>
			<th class="text-end ps-4">Max</th>
			<th class="text-end ps-4">Avg</th>
		</tr>
		</thead>
		<tbody>
		<tr>
			<td class="pe-4">Blood pressure - Systolic [mmHg]</td>
			<td class="text-end ps-4">@Report.Summary.SystolicSummary.Min</td>
			<td class="text-end ps-4">@Report.Summary.SystolicSummary.Max</td>
			<td class="text-end ps-4">@((Report.Summary.SystolicSummary.Avg is null)?"":Math.Round((decimal)Report.Summary.SystolicSummary.Avg,0))</td>
		</tr>
		<tr>
			<td class="pe-4">Blood pressure - Diastolic [mmHg]</td>
			<td class="text-end ps-4">@Report.Summary.DiastolicSummary.Min</td>
			<td class="text-end ps-4">@Report.Summary.DiastolicSummary.Max</td>
			<td class="text-end ps-4">@((Report.Summary.DiastolicSummary.Avg is null)?"":Math.Round((decimal)Report.Summary.DiastolicSummary.Avg,0))</td>
		</tr>
		<tr>
			<td class="pe-4">Pulse [bpm]</td>
			<td class="text-end ps-4">@Report.Summary.PulseSummary.Min</td>
			<td class="text-end ps-4">@Report.Summary.PulseSummary.Max</td>
			<td class="text-end ps-4">@((Report.Summary.PulseSummary.Avg is null)?"":Math.Round((decimal)Report.Summary.PulseSummary.Avg,0))</td>
		</tr>
		<tr>
			<td class="pe-4">Glucose [mg/dL]</td>
			<td class="text-end ps-4">@Report.Summary.GlucoseSummary.Min</td>
			<td class="text-end ps-4">@Report.Summary.GlucoseSummary.Max</td>
			<td class="text-end ps-4">@((Report.Summary.GlucoseSummary.Avg is null)?"":Math.Round((decimal)Report.Summary.GlucoseSummary.Avg,0))</td>
		</tr>
		<tr>
			<td class="pe-4">Weight [kg]</td>
			<td class="text-end ps-4">@Report.Summary.WeightSummary.Min</td>
			<td class="text-end ps-4">@Report.Summary.WeightSummary.Max</td>
			<td class="text-end ps-4">@((Report.Summary.WeightSummary.Avg is null)?"":Math.Round((decimal)Report.Summary.WeightSummary.Avg,2))</td>
		</tr>
		<tr>
			<td class="pe-4">BMI [kg/m²]</td>
			<td class="text-end ps-4">@Report.Summary.BmiSummary.Min</td>
			<td class="text-end ps-4">@Report.Summary.BmiSummary.Max</td>
			<td class="text-end ps-4">@((Report.Summary.BmiSummary.Avg is null)?"":Math.Round((decimal)Report.Summary.BmiSummary.Avg,2))</td>
		</tr>
		</tbody>
	</table>

	<h3 class="pt-3">Details</h3>
	<div class="table-responsive">
		<table class="table table-hover table-sm table-borderless">
			<thead class="table-bordered">
			<tr>
				<th>Date</th>
				<th>Blood pressure [mmHg] / pulse [bpm]</th>
				<th>Glucose [mg/dL]</th>
				<th>Weight [kg] / BMI [kg/m²]</th>
			</tr>
			</thead>
			<tbody>
			@foreach (var d in Report.Details)
			{
				var bCount = d.BloodPressure.Count();
				var gCount = d.Glucose.Count();
				var wCount = d.Weight.Count();
				var maxCount = Math.Max(bCount, Math.Max(gCount, wCount));
				if (maxCount == 0)
				{
					<tr class="border-bottom">
						<td colspan="4"></td>
					</tr>
					<tr>
						<td>@d.Date.ToString("yyyy-MM-dd")</td>
						<td colspan="3" class="text-center">no-data</td>
					</tr>
				}
				else
				{
					@for (int i = 0; i < maxCount; i++)
					{
						@if (i == 0)
						{
							<tr class="border-bottom">
								<td colspan="4"></td>
							</tr>
						}

						<tr>
							@if (i == 0)
							{
								<td rowspan="@maxCount" style="min-width:7em;">
									@d.Date.ToString("yyyy-MM-dd")
								</td>
							}
							<td style="min-width:22em;">
								@if (i < bCount)
								{
									<div class="d-inline-block" style="width:6em; font-size: 80%;">
										<span class="bi bi-clock pe-1"></span>
										@d.BloodPressure.ElementAt(i).Time
									</div>

									<div class="d-inline-block fs-5" style="width:5em;">
										<div class="badge rounded-pill bg-primary">
											@(d.BloodPressure.ElementAt(i).Systolic)/@(d.BloodPressure.ElementAt(i).Diastolic)
											<span class="bi bi-activity ps-2"></span>
										</div>
									</div>

									<div class="d-inline-block fs-5" style="width:6em;">
										<div class="badge rounded-pill bg-primary">
											@(d.BloodPressure.ElementAt(i).Pulse)
											<span class="bi bi-heart ps-2"></span>
										</div>
									</div>
								}
							</td>
							<td style="min-width:15em;">
								@if (i < gCount)
								{
									<div class="d-inline-block" style="width:6em; font-size: 80%;">
										<span class="bi bi-clock pe-1"></span>
										@d.Glucose.ElementAt(i).Time
									</div>

									<div class="d-inline-block fs-5" style="width:5em;">
										<div class="badge rounded-pill bg-primary">
											@(d.Glucose.ElementAt(i).Value)
											@if (d.Glucose.ElementAt(i).Meal is 0 or 1 or 2)
											{
												<span class="bi bi-cup-fill ps-2"></span>
											}
											else
											{
												<span class="bi bi-cup ps-2"></span>
											}
										</div>
									</div>

									<div class="d-inline-block fst-italic fst-lighter" style="font-size: 70%;">
										@d.Glucose.ElementAt(i).Note
									</div>
								}
							</td>
							<td style="min-width:23em;">
								@if (i < wCount)
								{
									<div class="d-inline-block" style="width:6em; font-size: 80%;">
										<span class="bi bi-clock pe-1"></span>
										@d.Weight.ElementAt(i).Time
									</div>

									<div class="d-inline-block fs-5" style="width:5em;">
										<div class="badge rounded-pill bg-primary">
											@(d.Weight.ElementAt(i).WeightKg)
											<span class="bi bi-speedometer2 ps-2"></span>
										</div>
									</div>

									<div class="d-inline-block fs-5" style="width:6em;">
										<div class="badge rounded-pill bg-primary">
											@(d.Weight.ElementAt(i).Bmi)
											<span class="bi bi-fire ps-2"></span>
										</div>
									</div>
								}
							</td>
						</tr>
					}
				}
			}
			</tbody>
		</table>
	</div>
}
