@page "/reports/simple"
@using System.Text.RegularExpressions
<h3>Simple report</h3>

<div class="row mb-3">
	<div class="col-md-3">
		<label class="form-label">Year</label>
		<input class="form-control" type="number" @bind="Year" min="@MinYear" max="@MaxYear"/>
	</div>
	<div class="col-md-3">
		<label class="form-label">Month</label>
		<select class="form-select" @bind="Month">
			@for (int m = 1; m <= 12; m++)
			{
				<option
					value="@m"> @m - @System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(m)</option>
			}
		</select>
	</div>
	<div class="col-md-3 d-flex align-items-end">
		<button class="btn btn-primary" @onclick="Submit">Go</button>
	</div>
</div>

@if (Report is not null && Report.Details.Count>0)
{
	<h3 class="pt-3">Summary</h3>
	<table class="table table-hover table-sm" style="width:auto;">
		<thead class="table-bordered">
		<tr>
			<th></th>
			<th class="text-end ps-4">Min</th>
			<th class="text-end ps-4">Max</th>
			<th class="text-end ps-4">Avg</th>
		</tr>
		</thead>
		<tbody>
		<tr>
			<td class="pe-4">Blood pressure - Systolic [mmHg]</td>
			<td class="text-end ps-4">@Report.Details.SelectMany(x => x.BloodPressure.Select(x => x.Systolic)).Min()</td>
			<td class="text-end ps-4">@Report.Details.SelectMany(x => x.BloodPressure.Select(x => x.Systolic)).Max()</td>
			<td class="text-end ps-4">@Math.Round(Report.Details.SelectMany(x => x.BloodPressure.Select(x => x.Systolic)).Average(), 0)</td>
		</tr>
		<tr>
			<td class="pe-4">Blood pressure - Diastolic [mmHg]</td>
			<td class="text-end ps-4">@Report.Details.SelectMany(x => x.BloodPressure.Select(x => x.Diastolic)).Min()</td>
			<td class="text-end ps-4">@Report.Details.SelectMany(x => x.BloodPressure.Select(x => x.Diastolic)).Max()</td>
			<td class="text-end ps-4">@Math.Round(Report.Details.SelectMany(x => x.BloodPressure.Select(x => x.Diastolic)).Average(), 0)</td>
		</tr>
		<tr>
			<td class="pe-4">Pulse</td>
			<td class="text-end ps-4">@Report.Details.SelectMany(x => x.BloodPressure.Select(x => x.Pulse)).Min()</td>
			<td class="text-end ps-4">@Report.Details.SelectMany(x => x.BloodPressure.Select(x => x.Pulse)).Max()</td>
			<td class="text-end ps-4">@Math.Round((decimal)Report.Details.SelectMany(x => x.BloodPressure.Select(x => x.Pulse)).Average(), 0)</td>
		</tr>
		<tr>
			<td class="pe-4">Glucose [mg/dL]</td>
			<td class="text-end ps-4">@Report.Details.SelectMany(x => x.Glucose.Select(x => x.Value)).Min()</td>
			<td class="text-end ps-4">@Report.Details.SelectMany(x => x.Glucose.Select(x => x.Value)).Max()</td>
			<td class="text-end ps-4">@Math.Round((decimal)Report.Details.SelectMany(x => x.Glucose.Select(x => x.Value)).Average(), 0)</td>
		</tr>
		<tr>
			<td class="pe-4">Weight [kg]</td>
			<td class="text-end ps-4">@Report.Details.SelectMany(x => x.Weight.Select(x => x.WeightKg)).Min()</td>
			<td class="text-end ps-4">@Report.Details.SelectMany(x => x.Weight.Select(x => x.WeightKg)).Max()</td>
			<td class="text-end ps-4">@Math.Round((decimal)Report.Details.SelectMany(x => x.Weight.Select(x => x.WeightKg)).Average(), 2)</td>
		</tr>
		<tr>
			<td class="pe-4">BMI</td>
			<td class="text-end ps-4">@Report.Details.SelectMany(x => x.Weight.Select(x => x.Bmi)).Min()</td>
			<td class="text-end ps-4">@Report.Details.SelectMany(x => x.Weight.Select(x => x.Bmi)).Max()</td>
			<td class="text-end ps-4">@Math.Round((decimal)Report.Details.SelectMany(x => x.Weight.Select(x => x.Bmi)).Average(), 2)</td>
		</tr>
		</tbody>
	</table>

	<h3 class="pt-3">Details</h3>
	<div class="table-responsive">
		<table class="table table-hover table-sm table-borderless">
			<thead class="table-bordered">
			<tr>
				<th>Date</th>
				<th>Blood pressure / pulse</th>
				<th>Glucose</th>
				<th>Weight / BMI</th>
			</tr>
			</thead>
			<tbody>
			@foreach (var d in Report.Details)
			{
				var bCount = d.BloodPressure.Count();
				var gCount = d.Glucose.Count();
				var wCount = d.Weight.Count();
				var maxCount = Math.Max(bCount, Math.Max(gCount, wCount));
				if (maxCount == 0)
				{
					<tr class="border-bottom">
						<td colspan="4"></td>
					</tr>
					<tr>
						<td>@d.Date.ToString("yyyy-MM-dd")</td>
						<td colspan="3" class="text-center">no-data</td>
					</tr>
				}
				else
				{
					@for (int i = 0; i < maxCount; i++)
					{
						@if (i == 0)
						{
							<tr class="border-bottom">
								<td colspan="4"></td>
							</tr>
						}

						<tr>
							@if (i == 0)
							{
								<td rowspan="@maxCount" style="min-width:7em;">
									@d.Date.ToString("yyyy-MM-dd")
								</td>
							}
							<td style="min-width:22em;">
								@if (i < bCount)
								{
									<div class="d-inline-block" style="width:6em; font-size: 80%;">
										<span class="bi bi-clock pe-1"></span>
										@d.BloodPressure.ElementAt(i).Time
									</div>

									<div class="d-inline-block fs-5" style="width:5em;">
										<div class="badge rounded-pill bg-primary">
											@(d.BloodPressure.ElementAt(i).Systolic)/@(d.BloodPressure.ElementAt(i).Diastolic)
											<span class="bi bi-activity ps-2"></span>
										</div>
									</div>

									<div class="d-inline-block fs-5" style="width:6em;">
										<div class="badge rounded-pill bg-primary">
											@(d.BloodPressure.ElementAt(i).Pulse)
											<span class="bi bi-heart ps-2"></span>
										</div>
									</div>
								}
							</td>
							<td style="min-width:15em;">
								@if (i < gCount)
								{
									<div class="d-inline-block" style="width:6em; font-size: 80%;">
										<span class="bi bi-clock pe-1"></span>
										@d.Glucose.ElementAt(i).Time
									</div>

									<div class="d-inline-block fs-5" style="width:5em;">
										<div class="badge rounded-pill bg-primary">
											@(d.Glucose.ElementAt(i).Value)
											@if (d.Glucose.ElementAt(i).Meal is 0 or 1 or 2)
											{
												<span class="bi bi-cup ps-2"></span>
											}
											else
											{
												<span class="bi bi-cup-fill ps-2"></span>
											}
										</div>
									</div>

									<div class="d-inline-block fst-italic fst-lighter" style="font-size: 70%;">
										@d.Glucose.ElementAt(i).Note
									</div>
								}
							</td>
							<td style="min-width:23em;">
								@if (i < wCount)
								{
									<div class="d-inline-block" style="width:6em; font-size: 80%;">
										<span class="bi bi-clock pe-1"></span>
										@d.Weight.ElementAt(i).Time
									</div>

									<div class="d-inline-block fs-5" style="width:5em;">
										<div class="badge rounded-pill bg-primary">
											@(d.Weight.ElementAt(i).WeightKg)
											<span class="bi bi-speedometer2 ps-2"></span>
										</div>
									</div>

									<div class="d-inline-block fs-5" style="width:6em;">
										<div class="badge rounded-pill bg-primary">
											@(d.Weight.ElementAt(i).Bmi)
											<span class="bi bi-fire ps-2"></span>
										</div>
									</div>
								}
							</td>
						</tr>
					}
				}
			}
			</tbody>
		</table>
	</div>
}
@* Code moved to Simple.razor.cs *@

