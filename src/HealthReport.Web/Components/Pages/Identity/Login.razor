@page "/identity/login"

<div class="loginForm">
    <h3 class="display-5 mb-3">Login</h3>

    @if (Error != 0)
    {
        <div class="alert alert-danger p-2">
            <span class="bi bi-exclamation-circle-fill me-2"></span>
            @ErrorDescription
        </div>
    }

    <form id="loginForm" @formname="loginForm" method="post" action="/identity/login-submit"
          class="d-flex flex-column">
        
        <input type="hidden" name="__RequestVerificationToken" id="__RequestVerificationToken" value="@CsrfToken"/>
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input name="email" type="email" class="form-control" required/>
        </div>
        <div class="mb-3">
            <label class="form-label">Password</label>
            <input name="password" type="password" class="form-control" required/>
        </div>
        
        <button class="btn btn-primary" type="submit">Login</button>
        <p class="mb-3 mt-3 text-center">
            Don't have an account? <NavLink href="/identity/register">Register here</NavLink>
        </p>
    </form>
</div>