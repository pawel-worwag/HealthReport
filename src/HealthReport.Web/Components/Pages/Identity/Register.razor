@page "/identity/register"

<div class="registerForm">
	<h3 class="display-5 mb-3">Register user</h3>

	@if (errors?.Any() == true)
	{
		<div class="alert alert-danger p-2">
			<ul>
				@foreach (var e in errors)
				{
					<li>
						<span class="bi bi-exclamation-circle-fill me-2"></span> @e
					</li>
				}
			</ul>
		</div>
	}

	<EditForm Model="model" OnValidSubmit="HandleValidSubmit" class="d-flex flex-column">
		<DataAnnotationsValidator/>

		<div class="mb-3">
			<label class="form-label">Email</label>
			<InputText class="form-control" @bind-Value="model.Email"/>
			<ValidationMessage For="() => model.Email" class="text-danger ms-2 fst-italic"/>
		</div>

		<div class="mb-3">
			<label class="form-label">Password</label>
			<InputText type="password" class="form-control" @bind-Value="model.Password"/>
			<ValidationMessage For="() => model.Password" class="text-danger ms-2 fst-italic"/>
		</div>

		<div class="mb-3">
			<label class="form-label">Confirm password</label>
			<InputText type="password" class="form-control" @bind-Value="model.ConfirmPassword"/>
			<ValidationMessage For="() => model.ConfirmPassword" class="text-danger ms-2 fst-italic"/>
		</div>

		<button class="btn btn-primary" type="submit" disabled="@isSubmitting">Register</button>
		@if (isSubmitting)
		{
			<span class="ms-2">Processing...</span>
		}
	</EditForm>
</div>