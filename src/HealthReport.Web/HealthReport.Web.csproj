<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>HealthReport.Web</UserSecretsId>
    </PropertyGroup>
    <PropertyGroup>
        <WarningsAsErrors>CS0618;CS0619</WarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Scalar.AspNetCore"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\HealthReport.Identity\HealthReport.Identity.csproj"/>
        <ProjectReference Include="..\HealthReport.Infrastructure\HealthReport.Infrastructure.csproj"/>
        <ProjectReference Include="..\HealthReport.Application\HealthReport.Application.csproj"/>
        <ProjectReference Include="..\HealthReport.Domain\HealthReport.Domain.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <Folder Include="wwwroot\lib\"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Include vendor libraries from wwwroot/lib in publish output. -->
        <!-- Files under wwwroot are usually included automatically, but when
             restoring vendor files during build (LibMan/npm) ensure they are
             copied to the publish directory by declaring them as Content. -->
        <Content Update="wwwroot\lib\**\*">
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>
    <ItemGroup>
      <_ContentIncludedByDefault Remove="Components\Shared\Charts\TimePointSeriesGraph.razor" />
    </ItemGroup>

    <!-- Run LibMan restore via dotnet tool before build when libman.json is present -->
    <Target Name="LibManToolRestore" BeforeTargets="PrepareForBuild" Condition="Exists('$(MSBuildProjectDirectory)\libman.json')">
        <Message Importance="high" Text="Restoring dotnet tools (for libman) and running libman restore..."/>
        <Exec Command="dotnet tool restore"/>
        <Exec Command="dotnet tool run libman restore" WorkingDirectory="$(MSBuildProjectDirectory)"/>
    </Target>
</Project>
